{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck.local/schemas/ck-extension-sdk-release-channel.schema.json",
  "title": "CK Extension SDK release channel v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "sdk_version",
    "license",
    "artifact_file",
    "repository_relative_path",
    "public_url",
    "publication_status",
    "integrity_metadata_file",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "channel": { "const": "stable" },
    "sdk_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "license": { "const": "Apache-2.0" },
    "artifact_file": {
      "type": "string",
      "pattern": "^CK-Extension-SDK-[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?\\.zip$"
    },
    "repository_relative_path": {
      "type": "string",
      "pattern": "^artifacts/release/CK-Extension-SDK-.+\\.zip$"
    },
    "public_url": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "uri", "pattern": "^https://" }
      ]
    },
    "publication_status": { "enum": ["local-artifact-ready", "published"] },
    "integrity_metadata_file": {
      "type": "string",
      "pattern": "^CK-Extension-SDK-.+\\.release\\.json$"
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "publication_status": { "const": "local-artifact-ready" } } },
      "then": { "properties": { "public_url": { "type": "null" } } },
      "else": { "properties": { "public_url": { "type": "string", "pattern": "^https://" } } }
    }
  ]
}
