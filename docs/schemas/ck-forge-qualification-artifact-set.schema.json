{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck.local/schemas/ck-forge-qualification-artifact-set.schema.json",
  "title": "CK Forge qualification artifact set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "artifacts"],
  "properties": {
    "schemaId": { "const": "ck.forge.qualification-artifact-set" },
    "schemaVersion": { "const": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "size": { "type": "integer", "minimum": 0, "maximum": 134217728 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
