{
  "schema": "ck-builtin-block-compatibility",
  "version": 1,
  "scope": "first-party blocks exposed by the built-in static toolbox or CK_FUNCTIONS dynamic flyout",
  "claims": {
    "generatorRegistration": "Every listed block must have a registered first-party generator.",
    "generatorSmoke": "Static generation proves that a default block instance can emit code without throwing; it is not a compile or hardware claim.",
    "compileOnly": "Only blocks named by a representativeCompileSuites entry inherit that suite's compile-only evidence.",
    "architectureAvailability": "A supported target means the block is intended for that architecture; it does not imply compile or hardware evidence.",
    "hardwareTested": false,
    "hardwareStatement": "No physical board execution or peripheral behavior is claimed by this catalog."
  },
  "targets": [
    {
      "id": "avr-nano",
      "fqbn": "arduino:avr:nano",
      "coreId": "arduino:avr",
      "coreVersion": "1.8.6"
    },
    {
      "id": "esp32-c6",
      "fqbn": "esp32:esp32:esp32c6",
      "coreId": "esp32:esp32",
      "coreVersion": "3.3.6"
    }
  ],
  "defaultRule": {
    "classification": "portable-api-intent",
    "supportedTargets": ["avr-nano", "esp32-c6"],
    "compileEvidence": "not-covered-unless-listed-in-representative-suite"
  },
  "architectureRules": [
    {
      "classification": "esp-wifi-family",
      "types": [
        "wifi_connect",
        "wifi_get_channel",
        "wifi_get_rssi",
        "wifi_local_ip",
        "wifi_wait_until_ready"
      ],
      "supportedTargets": ["esp32-c6"],
      "unsupportedTargets": ["avr-nano"],
      "reason": "Requires the supported ESP32/ESP8266 Wi-Fi API; AVR is intentionally excluded."
    },
    {
      "classification": "esp32-c5-c6-wifi6",
      "types": ["wifi_set_protocol"],
      "supportedTargets": ["esp32-c6"],
      "unsupportedTargets": ["avr-nano"],
      "reason": "The built-in toolbox exposes this protocol control only for supported ESP32-C5/C6 cores."
    },
    {
      "classification": "esp32-uart-pins",
      "types": ["serial_setup_with_pins"],
      "supportedTargets": ["esp32-c6"],
      "unsupportedTargets": ["avr-nano"],
      "reason": "The RX/TX overload is an ESP32 HardwareSerial capability in the current built-in matrix."
    }
  ],
  "representativeCompileSuites": [
    {
      "id": "portable-core",
      "targets": ["avr-nano", "esp32-c6"],
      "blocks": [
        "controls_setup_custom",
        "serial_setup",
        "set_pin_mode",
        "math_number",
        "controls_loop_custom",
        "write_digital",
        "io_level",
