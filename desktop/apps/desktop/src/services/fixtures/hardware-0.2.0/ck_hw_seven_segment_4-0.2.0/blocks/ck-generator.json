      "includes": {
        "driver": "#include <CKKitSegment4.h>"
      }
    },
    {
      "type": "ck_hw_seven_segment_4_number",
      "kind": "statement",
      "template": "ckKitSegment4Number({{value:NUMBER}}, {{field:DECIMALS}});",
      "includes": {
        "driver": "#include <CKKitSegment4.h>"
      }
    },
    {
      "type": "ck_hw_seven_segment_4_refresh",
      "kind": "statement",
      "template": "ckKitSegment4Refresh();",
      "includes": {
        "driver": "#include <CKKitSegment4.h>"
      }
    },
    {
      "type": "ck_hw_seven_segment_4_blank",
      "kind": "statement",
      "template": "ckKitSegment4Blank();",
      "includes": {
        "driver": "#include <CKKitSegment4.h>"
      }
    }
  ]
}
