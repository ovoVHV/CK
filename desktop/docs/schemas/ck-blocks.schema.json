{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck.local/schemas/ck-blocks-v1.schema.json",
  "title": "CK Blockly Library Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "display_name", "description", "entrypoints", "blocks"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boards": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "architectures": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks", "generator", "toolbox"],
      "properties": {
        "blocks": { "$ref": "#/$defs/jsonEntrypoint" },
        "generator": { "$ref": "#/$defs/jsonEntrypoint" },
        "toolbox": { "$ref": "#/$defs/toolboxEntrypoint" }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "not": { "pattern": "^(?:[A-Za-z]:|[/\\\\])" } },
        { "not": { "pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)" } }
      ]
    },
    "jsonEntrypoint": {
      "allOf": [
        { "$ref": "#/$defs/relativePath" },
        { "pattern": "\\.[Jj][Ss][Oo][Nn]$" }
      ]
    },
    "toolboxEntrypoint": {
      "allOf": [
        { "$ref": "#/$defs/relativePath" },
        { "pattern": "\\.(?:[Jj][Ss][Oo][Nn]|[Xx][Mm][Ll])$" }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "default": {},
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["value", "statement"] },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "check": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ]
        },
        "default": {}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "display_name", "description"],
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["statement", "value", "hat", "terminal"] },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
        "output": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            { "type": "null" }
          ]
        },
        "requires": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
