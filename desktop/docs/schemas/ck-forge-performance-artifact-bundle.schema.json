{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck.local/schemas/ck-forge-performance-artifact-bundle.schema.json",
  "title": "CK Forge performance qualification artifact bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "candidateSha256",
    "captureReportSha256",
    "artifactManifestSha256",
    "representativeLane",
    "representativeTrialId",
    "representativeStage"
  ],
  "properties": {
    "schemaId": { "const": "ck.forge.performance-artifact-bundle" },
    "schemaVersion": { "const": 1 },
    "candidateSha256": { "$ref": "#/$defs/sha256" },
    "captureReportSha256": { "$ref": "#/$defs/sha256" },
    "artifactManifestSha256": { "$ref": "#/$defs/sha256" },
    "representativeLane": { "const": "native" },
    "representativeTrialId": {
      "type": "string",
      "minLength": 1,
      "description": "The first native candidate trial; installers reject any other representative."
    },
    "representativeStage": { "const": "simple-return" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
