{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ck.local/schemas/ck-board-lock-v1.schema.json",
  "title": "CK Board Passport Lock",
  "description": "The exact ck.lock structure generated by CK for one installed third-party board package. ck.lock is excluded from package content hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_by",
    "generated_at",
    "certification_engine_contract",
    "board",
    "source_package_sha256",
    "source_content_sha256",
    "installed_content_sha256",
    "menu_schema_sha256",
    "core_requirement",
    "core",
    "evidence_provenance",
    "certification_status",
    "invalidated_reasons",
    "profiles"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_by": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generated_at": { "type": "string", "format": "date-time" },
    "certification_engine_contract": { "$ref": "#/$defs/certificationEngineContract" },
    "board": { "$ref": "#/$defs/boardIdentity" },
    "source_package_sha256": { "$ref": "#/$defs/sha256" },
    "source_content_sha256": { "$ref": "#/$defs/sha256" },
    "installed_content_sha256": { "$ref": "#/$defs/sha256" },
    "menu_schema_sha256": { "$ref": "#/$defs/sha256" },
    "core_requirement": { "$ref": "#/$defs/coreRequirement" },
    "core": { "$ref": "#/$defs/coreCompatibility" },
    "evidence_provenance": {
      "type": "string",
      "enum": ["local", "publisher", "ck"],
      "description": "Overall source of this passport. Local records are never portable; publisher and CK records require independently verified signatures."
    },
    "certification_status": { "$ref": "#/$defs/status" },
    "invalidated_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/status" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "nullableSemver": {
      "oneOf": [
        { "$ref": "#/$defs/semver" },
        { "type": "null" }
      ]
    },
    "versionToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "toolchainKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "buildSignature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "certificationEngineContract": {
      "const": "ck-fast-build-contract-v9:command-scoped-ccache-native-file-paths-O1-final-g0-no-lto-expanded-ccdb-core-deps-portable-response-guard",
      "description": "The CK compiler/evidence contract that produced this passport. A changed or missing value invalidates prior compile certification."
    },
    "nullableVersionToken": {
      "oneOf": [
        { "$ref": "#/$defs/versionToken" },
        { "type": "null" }
      ]
    },
    "optionMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "boardIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "vendor", "fqbn_base"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "vendor": { "type": "string", "minLength": 1 },
        "fqbn_base": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      }
    },
    "incompatibleSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "version_range": { "type": "string", "minLength": 1, "maxLength": 256 },
        "minimum": { "$ref": "#/$defs/semver" },
        "maximum_exclusive": { "$ref": "#/$defs/semver" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "anyOf": [
        { "required": ["version"] },
        { "required": ["version_range"] },
        { "required": ["minimum"] },
        { "required": ["maximum_exclusive"] }
      ]
    },
    "coreRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "tested_versions", "known_incompatible"],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "recommended_version": { "$ref": "#/$defs/semver" },
        "version_range": { "type": "string", "minLength": 1, "maxLength": 256 },
        "min_version": {
          "$ref": "#/$defs/semver",
          "description": "The only range-derived hard lower blocker."
        },
        "max_version": {
          "$ref": "#/$defs/semver",
          "description": "Legacy tested upper marker. Exceeding it requires revalidation but does not block."
        },
        "maximum_exclusive": {
          "$ref": "#/$defs/semver",
          "description": "Exclusive publisher-tested upper edge. Exceeding it requires revalidation but does not block."
        },
        "tested_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/semver" }
        },
        "known_incompatible": {
          "type": "array",
          "items": { "$ref": "#/$defs/incompatibleSelector" }
        },
        "index_url": { "type": "string", "format": "uri" }
      }
    },
    "compatibilityWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/status" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "coreCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "status",
        "usable",
        "requires_revalidation",
        "installed_version",
        "installed_versions",
        "recommended_version",
        "recommended_version_installed",
        "warnings",
        "message"
      ],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "status": { "$ref": "#/$defs/status" },
        "usable": { "type": "boolean" },
        "requires_revalidation": { "type": "boolean" },
        "installed_version": {
          "$ref": "#/$defs/nullableVersionToken",
          "description": "The actual installed core selected for this lock; no separate desired or forced version is stored."
        },
        "installed_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/versionToken" }
        },
        "recommended_version": { "$ref": "#/$defs/nullableSemver" },
        "recommended_version_installed": { "type": "boolean" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/compatibilityWarning" }
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "payload_sha256", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "value": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9+/=_-]+$"
        }
      }
    },
    "smokeResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "mode", "status", "duration_ms"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "mode": {
          "type": "string",
          "enum": ["compile-only", "device-upload", "serial-runtime"]
        },
        "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
        "declared": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "log_sha256": { "$ref": "#/$defs/sha256" },
        "error_sha256": { "$ref": "#/$defs/sha256" },
        "toolchain_key": { "$ref": "#/$defs/toolchainKey" },
        "build_signature": { "$ref": "#/$defs/buildSignature" },
        "flash_used_bytes": { "type": "integer", "minimum": 0 },
        "ram_used_bytes": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "declared_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 900 },
        "timeout_enforced": {
          "const": false,
          "description": "Desktop certification v1 records the declared timeout but does not yet enforce process termination at that deadline."
        },
        "failure_reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "partition_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Required by backend semantics for successful ESP32 compile-only evidence."
        },
        "partition_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Exactly 64 hexadecimal characters; required with partition_path."
        }
      },
      "dependentRequired": {
        "partition_path": ["partition_sha256"],
        "partition_sha256": ["partition_path"]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": { "const": "compile-only" },
              "status": { "const": "passed" }
            },
            "required": ["mode", "status"]
          },
          "then": {
            "required": [
              "declared",
              "source_sha256",
              "log_sha256",
              "toolchain_key",
              "build_signature",
              "warning_count",
              "timeout_enforced"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": { "const": "compile-only" },
              "status": { "const": "passed" },
              "declared": { "const": true }
            },
            "required": ["mode", "status", "declared"]
          },
          "then": { "required": ["declared_timeout_seconds"] }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "provenance", "stage", "duration_ms"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "environment-result",
            "compile-result",
            "device-result",
            "upload-result",
            "runtime-result"
          ]
        },
        "provenance": { "type": "string", "enum": ["local", "publisher", "ck"] },
        "stage": {
          "type": "string",
          "enum": ["structure", "environment", "compile", "device", "upload", "runtime"]
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "certification_engine_contract": {
          "$ref": "#/$defs/certificationEngineContract"
        },
        "canonical_fqbn": {
          "type": "string",
          "pattern": "^[^\\s:]+:[^\\s:]+:[^\\s:]+(?::[^\\s]+)?$"
        },
        "smoke": { "type": "string", "minLength": 1, "maxLength": 256 },
        "declared_smoke_tests_executed": { "type": "boolean" },
        "matrix_executed": { "type": "boolean" },
        "toolchain_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolchainKey" }
        },
        "build_signatures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/buildSignature" }
        },
        "smoke_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/smokeResult" }
        },
        "log_sha256": { "$ref": "#/$defs/sha256" },
        "error_sha256": { "$ref": "#/$defs/sha256" },
        "result": { "type": "string", "minLength": 1, "maxLength": 256 },
        "error": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "diagnostics": {},
        "signature": { "$ref": "#/$defs/signature" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "compile-result" } },
            "required": ["kind"]
          },
          "then": {
            "required": [
              "declared_smoke_tests_executed",
              "matrix_executed",
              "certification_engine_contract",
              "canonical_fqbn",
              "toolchain_keys",
              "build_signatures",
              "smoke_results"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "compile-result" },
              "canonical_fqbn": { "pattern": "^esp32:" }
            },
            "required": ["kind", "canonical_fqbn"]
          },
          "then": {
            "properties": {
              "smoke_results": {
                "items": {
                  "if": {
                    "properties": {
                      "mode": { "const": "compile-only" },
                      "status": { "const": "passed" }
                    },
                    "required": ["mode", "status"]
                  },
                  "then": { "required": ["partition_path", "partition_sha256"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "provenance": { "enum": ["publisher", "ck"] } },
            "required": ["provenance"]
          },
          "then": { "required": ["signature"] }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "options", "smoke_tests", "fqbn", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "hardware_variant": { "$ref": "#/$defs/id" },
        "options": { "$ref": "#/$defs/optionMap" },
        "smoke_tests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "fqbn": {
          "type": "string",
          "pattern": "^[^\\s:]+:[^\\s:]+:[^\\s:]+(?::[^\\s]+)?$"
        },
        "status": { "$ref": "#/$defs/status" },
        "checked_at": { "type": "string", "format": "date-time" },
        "core_version": { "$ref": "#/$defs/versionToken" },
        "toolchain_key": {
          "$ref": "#/$defs/toolchainKey",
          "description": "Semantic requirement after compile_passed or device_verified; must match the single certified evidence toolchain key."
        },
        "installed_content_sha256": { "$ref": "#/$defs/sha256" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["compile_passed", "device_verified"] }
            },
            "required": ["status"]
          },
          "then": {
            "required": [
              "checked_at",
              "core_version",
              "toolchain_key",
              "installed_content_sha256",
              "evidence"
            ]
          }
        }
      ]
    }
  }
}
