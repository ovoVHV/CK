{
  "schema_version": 2,
  "id": "ck_example_i2c_sensor_v2",
  "display_name": "CK I2C 传感器元数据 v2 示例",
  "description": "演示可供质量门禁、搜索、文档和 AI 共同消费的完整积木语义契约。",
  "keywords": ["example", "sensor", "i2c", "temperature"],
  "license": {
    "spdx_id": "MIT",
    "file": "LICENSE"
  },
  "compatibility": {
    "boards": ["arduino:*:*", "esp32:esp32:*"],
    "architectures": ["avr", "esp32"]
  },
  "dependencies": [
    {
      "kind": "arduino-library",
      "id": "CK Example Sensor",
      "version": ">=1.2.0 <2.0.0",
      "headers": ["CKExampleSensor.h"],
      "optional": false,
      "reason": "提供传感器初始化和温度读取 API。",
      "license": "MIT"
    },
    {
      "kind": "header",
      "id": "Wire.h",
      "headers": ["Wire.h"],
      "optional": false,
      "reason": "使用板卡核心提供的 I2C 总线。"
    }
  ],
  "entrypoints": {
    "blocks": "blocks/blocks.js",
    "generator": "blocks/generator.js",
    "toolbox": "blocks/toolbox.xml"
  },
  "blocks": [
    {
      "type": "ck_example_read_temperature_v2",
      "display_name": "读取 I2C 温度",
      "description": "从指定 I2C 地址读取摄氏温度。",
      "category": "传感器 / 温度",
      "kind": "value",
      "keywords": ["read", "temperature", "celsius", "i2c"],
      "semantics": {
        "purpose": "获取当前环境温度供显示、判断或记录使用。",
        "behavior": "首次生成时初始化默认 I2C 总线，执行时同步读取一次传感器并返回摄氏温度。",
        "side_effects": ["占用默认 I2C 总线", "读取期间最多阻塞 5 毫秒"],
        "concepts": ["temperature", "sensor-read", "i2c"]
      },
      "fields": [
        {
          "name": "ADDRESS",
          "kind": "dropdown",
          "description": "传感器的 7 位 I2C 地址。",
          "required": true,
          "default": "0x48",
          "options": [
            { "label": "0x48", "value": "0x48" },
            { "label": "0x49", "value": "0x49" }
          ]
        }
      ],
      "inputs": [],
      "output": {
        "connection": "value",
        "types": ["Number"],
        "description": "当前温度。传感器读取失败时返回 NAN。",
        "unit": "°C",
        "nullable": false
      },
      "dependencies": [],
      "hardware": {
        "resources": [
          {
            "kind": "i2c",
            "id": "default-i2c",
            "source": { "kind": "board-default" },
            "access": "read-write",
            "sharing": "shared",
            "quantity": 1,
            "capabilities": ["controller"],
            "description": "使用板卡定义的默认 SDA/SCL 引脚和 I2C 控制器。"
          }
        ],
        "architectures": ["avr", "esp32"],
        "notes": ["同一总线上的设备必须使用不同的 7 位地址。"]
      },
      "generation": {
        "language": "arduino-cpp",
        "shape": "expression",
        "deterministic": true,
        "includes": ["Wire.h", "CKExampleSensor.h"],
        "calls": ["Wire.begin", "CKExampleSensor::begin", "CKExampleSensor::readCelsius"],
        "emissions": [
          {
            "section": "include",
            "description": "每个工程只生成一次 Wire.h 和 CKExampleSensor.h 头文件。"
          },
          {
            "section": "global",
            "description": "按 I2C 地址复用一个 CKExampleSensor 实例。"
          },
          {
            "section": "setup",
            "description": "初始化默认 I2C 总线并启动传感器。"
          },
          {
            "section": "expression",
            "description": "生成返回 float 的 readCelsius 调用。",
            "template": "ckSensor_ADDRESS.readCelsius()"
          }
        ],
        "notes": ["生成器不得访问网络、文件系统或执行外部命令。"]
      },
      "constraints": [
        {
          "id": "supported-address",
          "severity": "error",
          "description": "示例硬件只支持两个焊盘地址。",
          "check": {
            "target": "field.ADDRESS",
            "operator": "one-of",
            "value": ["0x48", "0x49"]
          },
          "message": "I2C 地址必须为 0x48 或 0x49。",
          "recovery": "检查模块地址焊盘并在积木下拉框中选择对应地址。"
        },
        {
          "id": "board-i2c-required",
          "severity": "error",
          "description": "目标板卡必须提供可用的 I2C 控制器。",
          "check": {
            "target": "board",
            "operator": "board-capability",
            "value": "i2c-controller"
          },
          "message": "当前板卡没有声明可用 I2C 控制器。",
          "recovery": "选择带 I2C 的板卡，或为第三方板卡补充可信的能力声明。"
        }
      ],
      "examples": [
        {
          "id": "serial-temperature",
          "title": "每秒输出一次温度",
          "description": "把温度值连接到串口输出，并在循环末尾等待一秒。",
          "field_values": { "ADDRESS": "0x48" },
          "input_values": {},
          "expected_code_contains": ["#include <Wire.h>", "readCelsius()"],
          "expected_behavior": "串口监视器每秒显示一次以摄氏度表示的温度。",
          "boards": ["arduino:avr:uno", "esp32:esp32:esp32c6"]
        }
      ],
      "errors": [
        {
          "code": "I2C_DEVICE_NOT_FOUND",
          "severity": "error",
          "message": "没有在所选地址发现温度传感器。",
          "cause": "地址选择错误、接线断开或传感器未供电。",
          "recovery": "运行 I2C 扫描，核对 SDA/SCL、供电和 ADDRESS 字段。"
        }
      ]
    }
  ]
}
