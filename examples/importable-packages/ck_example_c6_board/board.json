{
  "schema_version": 1,
  "id": "ck_example_c6_board",
  "name": "CK 示例 C6 多配置板",
  "version": "1.0.0",
  "description": "第三方板厂如何用同一个 ESP32-C6 Arduino 目标声明 N4、N8 与 N16 三种物理 BOM、有限编译矩阵和受控 smoke test 的可导入示例。",
  "vendor": "CK Example Hardware",
  "architecture": "esp32",
  "icon": "assets/board.svg",
  "fqbn_base": "esp32:esp32:esp32c6",
  "arduino_core": {
    "package": "esp32:esp32",
    "version": "3.3.6",
    "recommended_version": "3.3.6",
    "version_range": {
      "minimum": "3.3.0",
      "maximum_exclusive": "4.0.0"
    },
    "tested_versions": ["3.3.6"],
    "known_incompatible": [],
    "index_url": "https://espressif.github.io/arduino-esp32/package_esp32_index.json"
  },
  "capabilities": {
    "wifi": true,
    "bluetooth": false,
    "bluetooth_le": true,
    "zigbee": true,
    "thread": true,
    "psram": false,
    "usb_cdc": true,
    "usb_jtag": true,
    "ota": true,
    "filesystem": true
  },
  "pins": [
    {
      "label": "D2 / GPIO2",
      "value": "2",
      "aliases": ["GPIO2", "IO2"],
      "capabilities": ["digital", "analog", "pwm", "interrupt"],
      "sharing": "board-defined",
      "connector": { "id": "J1", "side": "left", "position": 1 },
      "source": "publisher-declaration",
      "evidence": [{ "kind": "board-definition", "reference": "board.json#pins/0" }]
    },
    {
      "label": "D3 / GPIO3",
      "value": "3",
      "aliases": ["GPIO3", "IO3"],
      "capabilities": ["digital", "analog", "pwm", "interrupt"],
      "sharing": "board-defined",
      "connector": { "id": "J1", "side": "left", "position": 2 },
      "source": "publisher-declaration",
      "evidence": [{ "kind": "board-definition", "reference": "board.json#pins/1" }]
    },
    {
      "label": "D4 / GPIO4",
      "value": "4",
      "aliases": ["GPIO4", "IO4"],
      "capabilities": ["digital", "analog", "pwm", "interrupt"],
      "sharing": "board-defined",
      "connector": { "id": "J1", "side": "left", "position": 3 },
      "source": "publisher-declaration",
      "evidence": [{ "kind": "board-definition", "reference": "board.json#pins/2" }]
    },
    {
      "label": "D5 / GPIO5",
      "value": "5",
      "aliases": ["GPIO5", "IO5"],
      "capabilities": ["digital", "analog", "pwm", "interrupt"],
      "sharing": "board-defined",
      "connector": { "id": "J1", "side": "left", "position": 4 },
      "source": "publisher-declaration",
      "evidence": [{ "kind": "board-definition", "reference": "board.json#pins/3" }]
    },
    {
      "label": "D6 / GPIO6",
      "value": "6",
      "aliases": ["GPIO6", "IO6"],
      "capabilities": ["digital", "pwm", "interrupt"],
      "sharing": "board-defined",
      "connector": { "id": "J1", "side": "left", "position": 5 },
      "source": "publisher-declaration",
      "evidence": [{ "kind": "board-definition", "reference": "board.json#pins/4" }]
    },
    {
      "label": "D7 / GPIO7",
      "value": "7",
      "aliases": ["GPIO7", "IO7"],
      "capabilities": ["digital", "pwm", "interrupt"],
      "sharing": "board-defined",
      "connector": { "id": "J1", "side": "left", "position": 6 },
      "source": "publisher-declaration",
      "evidence": [{ "kind": "board-definition", "reference": "board.json#pins/5" }]
    },
    {
      "label": "D12 / GPIO12 / USB D-",
      "value": "12",
      "aliases": ["GPIO12", "IO12", "USB_D_MINUS"],
      "capabilities": ["digital", "usb", "interrupt"],
      "risks": [{
        "code": "usb-jtag-active",
        "severity": "warning",
        "title": "Integrated USB/JTAG is using this pin",
        "detail": "Using this pin as GPIO while integrated USB/JTAG is enabled may interrupt the USB connection.",
        "roles": ["digital-output", "pwm"],
        "when": { "options": { "JTAGAdapter": "builtin" } }
      }],
      "reserved_by": "native-usb",
      "sharing": "exclusive",
      "connector": { "id": "J1", "side": "left", "position": 7 },
      "source": "publisher-declaration",
      "evidence": [{ "kind": "board-definition", "reference": "board.json#pins/6" }]
    },
    {
      "label": "D13 / GPIO13 / USB D+",
      "value": "13",
      "aliases": ["GPIO13", "IO13", "USB_D_PLUS"],
      "capabilities": ["digital", "usb", "interrupt"],
      "risks": [{
        "code": "usb-jtag-active",
        "severity": "warning",
        "title": "Integrated USB/JTAG is using this pin",
        "detail": "Using this pin as GPIO while integrated USB/JTAG is enabled may interrupt the USB connection.",
        "roles": ["digital-output", "pwm"],
        "when": { "options": { "JTAGAdapter": ["builtin"] } }
      }],
      "reserved_by": "native-usb",
      "sharing": "exclusive",
      "connector": { "id": "J1", "side": "left", "position": 8 },
      "source": "publisher-declaration",
      "evidence": [{ "kind": "board-definition", "reference": "board.json#pins/7" }]
    }
  ],
  "custom_menus": {
    "JTAGAdapter": {
      "label": "JTAG 调试器",
      "selected": "default",
      "options": [
        { "value": "default", "label": "关闭" },
        { "value": "builtin", "label": "集成 USB JTAG" }
      ]
    },
    "CDCOnBoot": {
      "label": "启动时 USB CDC",
      "selected": "default",
      "options": [
        { "value": "default", "label": "关闭" },
        { "value": "cdc", "label": "开启" }
      ]
    },
    "PartitionScheme": {
      "label": "分区方案",
      "selected": "default",
      "options": [
        { "value": "default", "label": "4 MiB 默认分区" },
        { "value": "huge_app", "label": "4 MiB 大应用" },
        { "value": "default_8MB", "label": "8 MiB 默认分区" },
        { "value": "zigbee_8MB", "label": "8 MiB Zigbee 分区" },
        { "value": "fatflash", "label": "16 MiB FATFS 分区" },
        { "value": "app3M_fat9M_16MB", "label": "16 MiB 3M 应用 + FATFS" }
      ]
    },
    "CPUFreq": {
      "label": "CPU 频率",
      "selected": "160",
      "options": [
        { "value": "160", "label": "160 MHz（Wi-Fi）" },
        { "value": "80", "label": "80 MHz（Wi-Fi）" }
      ]
    },
    "FlashMode": {
      "label": "Flash 模式",
      "selected": "qio",
      "options": [
        { "value": "qio", "label": "QIO" },
        { "value": "dio", "label": "DIO" }
      ]
    },
    "FlashFreq": {
      "label": "Flash 频率",
      "selected": "80",
      "options": [
        { "value": "80", "label": "80 MHz" },
        { "value": "40", "label": "40 MHz" }
      ]
    },
    "FlashSize": {
      "label": "Flash 容量",
      "selected": "4M",
      "options": [
        { "value": "4M", "label": "4 MiB" },
        { "value": "8M", "label": "8 MiB" },
        { "value": "16M", "label": "16 MiB" }
      ]
    },
    "UploadSpeed": {
      "label": "上传速度",
      "selected": "921600",
      "options": [
        { "value": "921600", "label": "921600" },
        { "value": "115200", "label": "115200" }
      ]
    },
    "DebugLevel": {
      "label": "核心日志级别",
      "selected": "none",
      "options": [
        { "value": "none", "label": "关闭" },
        { "value": "error", "label": "错误" }
      ]
    },
    "EraseFlash": {
      "label": "上传前擦除",
      "selected": "none",
      "options": [
        { "value": "none", "label": "关闭" },
        { "value": "all", "label": "全部擦除" }
      ]
    },
    "ZigbeeMode": {
      "label": "Zigbee 模式",
      "selected": "default",
      "options": [
        { "value": "default", "label": "关闭" },
        { "value": "ed", "label": "终端设备" }
      ]
    }
  },
  "hardware_variants": [
    {
      "id": "c6-n4",
      "name": "C6 N4",
      "description": "4 MiB Flash、无 PSRAM 的基础型号。",
      "default": true,
      "aliases": ["N4", "4MB"],
      "expected_hardware": {
        "chip": "ESP32-C6",
        "flash_bytes": 4194304,
        "psram_bytes": 0
      },
      "fixed_options": { "FlashSize": "4M" },
      "default_profile": "c6-n4-standard"
    },
    {
      "id": "c6-n8",
      "name": "C6 N8",
      "description": "8 MiB Flash、无 PSRAM 的 Zigbee 型号。",
      "aliases": ["N8", "8MB"],
      "expected_hardware": {
        "chip": "ESP32-C6",
        "flash_bytes": 8388608,
        "psram_bytes": 0
      },
      "fixed_options": { "FlashSize": "8M" },
      "default_profile": "c6-n8-zigbee-ed"
    },
    {
      "id": "c6-n16",
      "name": "C6 N16",
      "description": "16 MiB Flash、无 PSRAM 的大存储型号。",
      "aliases": ["N16", "16MB"],
      "expected_hardware": {
        "chip": "ESP32-C6",
        "flash_bytes": 16777216,
        "psram_bytes": 0
      },
      "fixed_options": { "FlashSize": "16M" },
      "default_profile": "c6-n16-storage"
    }
  ],
  "validation_profiles": [
    {
      "id": "c6-n4-standard",
      "name": "N4 标准配置",
      "hardware_variant": "c6-n4",
      "default": true,
      "options_complete": true,
      "options": {
        "JTAGAdapter": "default",
        "CDCOnBoot": "default",
        "PartitionScheme": "default",
        "CPUFreq": "160",
        "FlashMode": "qio",
        "FlashFreq": "80",
        "FlashSize": "4M",
        "UploadSpeed": "921600",
        "DebugLevel": "none",
        "EraseFlash": "none",
        "ZigbeeMode": "default"
      },
      "smoke_tests": ["wifi-compile"]
    },
    {
      "id": "c6-n8-zigbee-ed",
      "name": "N8 Zigbee 终端配置",
      "hardware_variant": "c6-n8",
      "options_complete": true,
      "options": {
        "JTAGAdapter": "default",
        "CDCOnBoot": "default",
        "PartitionScheme": "zigbee_8MB",
        "CPUFreq": "160",
        "FlashMode": "qio",
        "FlashFreq": "80",
        "FlashSize": "8M",
        "UploadSpeed": "921600",
        "DebugLevel": "none",
        "EraseFlash": "none",
        "ZigbeeMode": "ed"
      },
      "smoke_tests": ["wifi-compile", "zigbee-compile"]
    },
    {
      "id": "c6-n16-storage",
      "name": "N16 大存储配置",
      "hardware_variant": "c6-n16",
      "options_complete": true,
      "options": {
        "JTAGAdapter": "default",
        "CDCOnBoot": "default",
        "PartitionScheme": "app3M_fat9M_16MB",
        "CPUFreq": "160",
        "FlashMode": "qio",
        "FlashFreq": "80",
        "FlashSize": "16M",
        "UploadSpeed": "921600",
        "DebugLevel": "none",
        "EraseFlash": "none",
        "ZigbeeMode": "default"
      },
      "smoke_tests": ["wifi-compile"]
    }
  ],
  "smoke_tests": [
    {
      "id": "wifi-compile",
      "name": "Wi-Fi 头文件与链接烟测",
      "description": "只编译固定的包内 Arduino sketch，不连接网络、不上传设备。",
      "sketch": "smoke/wifi_compile/wifi_compile.ino",
      "mode": "compile-only",
      "timeout_seconds": 600,
      "profiles": ["c6-n4-standard", "c6-n8-zigbee-ed", "c6-n16-storage"],
      "resource_limits": {
        "max_flash_bytes": 1258291,
        "max_ram_bytes": 294912,
        "max_warnings": 0
      }
    },
    {
      "id": "zigbee-compile",
      "name": "Zigbee 配置烟测",
      "description": "确认 Zigbee 终端配置能包含并链接核心 Zigbee API。",
      "sketch": "smoke/zigbee_compile/zigbee_compile.ino",
      "mode": "compile-only",
      "timeout_seconds": 600,
      "profiles": ["c6-n8-zigbee-ed"],
      "resource_limits": {
        "max_flash_bytes": 3145728,
        "max_ram_bytes": 294912,
        "max_warnings": 0
      }
    }
  ],
  "validation_matrix": {
    "strategy": "bounded-pairwise",
    "max_cases": 8,
    "groups": [
      {
        "id": "n4-storage-modes",
        "base_profile": "c6-n4-standard",
        "dimensions": {
          "PartitionScheme": ["default", "huge_app"]
        },
        "smoke_tests": ["wifi-compile"]
      },
      {
        "id": "n8-zigbee-modes",
        "base_profile": "c6-n8-zigbee-ed",
        "dimensions": {
          "PartitionScheme": ["default_8MB", "zigbee_8MB"],
          "ZigbeeMode": ["default", "ed"]
        },
        "smoke_tests": ["wifi-compile", "zigbee-compile"]
      },
      {
        "id": "n16-storage-modes",
        "base_profile": "c6-n16-storage",
        "dimensions": {
          "PartitionScheme": ["fatflash", "app3M_fat9M_16MB"]
        },
        "smoke_tests": ["wifi-compile"]
      }
    ],
    "include": [
      { "profile": "c6-n4-standard" },
      { "profile": "c6-n8-zigbee-ed" },
      { "profile": "c6-n16-storage" },
      {
        "base_profile": "c6-n16-storage",
        "options": { "PartitionScheme": "fatflash" },
        "smoke_tests": ["wifi-compile"]
      }
    ],
    "exclude": [
      {
        "group": "n8-zigbee-modes",
        "when": {
          "PartitionScheme": "default_8MB",
          "ZigbeeMode": "ed"
        },
        "reason": "Zigbee 终端烟测必须使用 Zigbee 分区，不能与普通 8 MiB 分区交叉。"
      }
    ]
  }
}
