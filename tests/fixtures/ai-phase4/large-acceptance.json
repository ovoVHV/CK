          "value": 1
        }
      ],
      "assertions": [
        {
          "id": "a_eh_pre",
          "requirement": "r_lo",
          "kind": "pin",
          "atMs": 300,
          "pin": "D9",
          "value": 0
        },
        {
          "id": "a_eh_hold",
          "requirement": "r_estop",
          "kind": "pin",
          "atMs": 750,
