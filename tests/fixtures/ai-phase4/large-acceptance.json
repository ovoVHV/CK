          "atMs": 1050,
          "pin": "D9",
          "value": 1
        }
      ]
    },
    {
      "id": "s_blink_serial",
      "name": "D13心跳独立翻转且串口持续输出",
      "durationMs": 1100,
      "inputs": [
        {
          "atMs": 0,
          "pin": "A0",
          "value": 675
        },
        {
          "atMs": 0,
          "pin": "D2",
