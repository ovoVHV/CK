        {
          "id": "a_est_release_low",
          "requirement": "r_resume",
          "kind": "pin",
          "atMs": 950,
          "pin": "D9",
          "value": 0
        }
      ]
    },
    {
      "id": "s_estop_resume_high",
      "name": "急停期间中值升到900也不点亮，释放后恢复点亮",
      "durationMs": 1100,
      "inputs": [
        {
          "atMs": 0,
          "pin": "A0",
          "value": 200
        },
        {
          "atMs": 0,
          "pin": "D2",
          "value": 1
        },
        {
          "atMs": 400,
          "pin": "D2",
          "value": 0
