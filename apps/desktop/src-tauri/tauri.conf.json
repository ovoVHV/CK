{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CK",
  "version": "1.0.0",
  "identifier": "com.ai.makerblockly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": ["custom-protocol"]
  },
  "app": {
    "windows": [
      {
        "title": "CK",
        "width": 1024,
        "height": 768,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/arduino-cli.exe": "bin/arduino-cli.exe",
      "bin/arduino-cli.version.json": "bin/arduino-cli.version.json",
      "bin/GPL-3.0.txt": "licenses/GPL-3.0.txt",
      "../../../tools/ccache.exe": "bin/ccache.exe",
      "state/qualifications": "state/qualifications",
      "THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
